<ul class="pizzas-list">
  {{#each this}}
    <li class="pizzas-item">
      <article class="pizza" data-pizza-id="{{id}}">
        <div class="photo">
          <img src="{{image}}" alt="{{name}}" class="pizza-img" />
        </div>
        <h2 class="pizza-title">{{name}}</h2>
        <div class="pizza-price-container">
          <p class="pizza-price">{{price}}</p>
        </div>
        <ul class="pizza-ingredients">
          {{#each ingredients}}
            <li class="pizza-ingredients-item">
              {{this}}
            </li>
          {{/each}}
        </ul>
        <div class="pizza-actions">
          <button data-pizza-action="edit" class="action-btn edit">Edit</button>
          <button
            data-pizza-action="delete"
            class="action-btn delete"
          >Delete</button>
        </div>
      </article>
    </li>
  {{/each}}
</ul>